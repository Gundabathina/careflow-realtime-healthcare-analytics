# CareFlow Analytics - example environment variables
# Copy to .env and adjust as needed. Never commit your actual .env file.

# Optional: override the path to project_config.yaml
# CAREFLOW_PROJECT_CONFIG=config/project_config.yaml

# --- PostgreSQL warehouse (Phase 3B) -----------------------------------------
# Used by docker-compose.yml and src/careflow/warehouse/postgres_client.py.
# These are safe *development-only* defaults for a local, throwaway
# container -- change the password for anything beyond local development,
# and never commit a real .env file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=careflow
POSTGRES_USER=careflow_user
POSTGRES_PASSWORD=careflow_dev_password_change_me

# Optional. Unset behaves exactly as before this variable existed
# (libpq's own "prefer" default -- fine for local Docker Compose
# Postgres, which doesn't speak SSL). Managed cloud PostgreSQL
# (Render, RDS, etc.) generally requires SSL -- set this to `require`
# for those. Never leave POSTGRES_SSLMODE unset in production.
# POSTGRES_SSLMODE=require

# --- Apache Airflow orchestration (Phase 4A) ---------------------------------
# Used by docker-compose.yml's `airflow` profile (scripts/start_airflow.py).
# Airflow's metadata database is a SEPARATE PostgreSQL instance/database/
# credentials from the CareFlow analytics warehouse above -- never reuse
# POSTGRES_PASSWORD here.
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow_dev_password_change_me

# Generate real, unique values for anything beyond local development --
# never commit real values, never reuse these examples:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_FERNET_KEY=change_me_generate_a_real_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_generate_a_real_secret_key

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=airflow_admin_dev_password_change_me
AIRFLOW_ADMIN_EMAIL=admin@careflow.example

# UID the Airflow containers run as -- match your host UID (`id -u`) so
# bind-mounted dags/plugins/logs have correct file permissions. 50000 is
# Airflow's own image default and works out of the box on most systems.
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8081
DBT_TARGET=dev
